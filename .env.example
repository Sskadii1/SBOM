# ============================================================
# SBOM Security Dashboard - Environment Variables
# Copy this file to .env and fill in local values.
# Do not commit .env.
# ============================================================

COMPOSE_PROJECT_NAME=sbom-dashboard
APP_HOST_PORT=8501

# ------ Neo4j ------
# For Docker Desktop on Windows/macOS, host.docker.internal can reach Neo4j on the host.
# On Linux, replace this with the correct host IP or run Neo4j in the same network.
NEO4J_URI=bolt://host.docker.internal:7689
NEO4J_USER=neo4j
NEO4J_PASSWORD=change_me
NEO4J_DATABASE=neo4j

# ------ LLM integration (optional) ------
# Use either Anthropic or OpenRouter. Leave placeholders until configured locally.
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=your_anthropic_api_key_here
# OPENROUTER_API_KEY=your_openrouter_api_key_here
LLM_MODEL=claude-sonnet-4-6
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=2048
CLAUDE_PROMPT_CACHING_ENABLED=true
CLAUDE_PROMPT_CACHE_TTL=5m

# ------ GitHub API (optional but recommended for higher rate limits) ------
GITHUB_TOKEN=your_github_token_here

# ------ Vulnerability enrichment APIs (optional) ------
NVD_API_KEY=your_nvd_api_key_here
# NVD_API_KEYS=your_first_nvd_api_key_here,your_second_nvd_api_key_here
VULNCHECK_API_KEY=your_vulncheck_api_key_here

# ------ Runtime safety ------
# Keep disabled unless you are in an isolated, disposable environment.
ALLOW_UNTRUSTED_DEPENDENCY_INSTALL=false
