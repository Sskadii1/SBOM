# ============================================================
# SBOM Retrieval - Environment Variables
# Copy file này thành .env và điền giá trị thực
# ============================================================

# Compose project name to avoid colliding with another SBOM stack.
COMPOSE_PROJECT_NAME=sbom8501
# Keep this stack on 8501 for side-by-side comparison.
APP_HOST_PORT=8501

# ------ Neo4j ------
# Windows/Mac Docker: host.docker.internal trỏ đến máy host
# Linux Docker: thay bằng IP thực của host (ví dụ: 172.17.0.1)
SBOM_NEO4J_URI=bolt://host.docker.internal:7689
SBOM_NEO4J_USER=neo4j
SBOM_NEO4J_PASSWORD=password
SBOM_NEO4J_DATABASE=neo4j

# ------ OpenRouter LLM (gui_retrieval) ------
# Lấy key tại: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here
LLM_MODEL=nvidia/nemotron-3-super-120b-a12b:free
# LLM_TEMPERATURE=0.1
# LLM_MAX_TOKENS=2048

# ------ GitHub (knowledge_graph - pipeline) ------
# Lấy token tại: https://github.com/settings/tokens
GITHUB_TOKEN=your_github_token_here

# ------ NVD API (knowledge_graph - enrichment) ------
# Lấy key tại: https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=your_nvd_api_key_here
# Nếu có nhiều key (round-robin), dùng dấu phẩy:
# NVD_API_KEYS=key1,key2,key3
VULNCHECK_API_KEY=your_vulncheck_api_key_here
